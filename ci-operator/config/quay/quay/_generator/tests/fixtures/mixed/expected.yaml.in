tests:
- as: aws-s3-nightly
  cron: '@daily'
  reporter_config:
    channel: "#team-quay-downstream-interruptions"
    job_states_to_report:
    - failure
    - error
    report_template: ":red_circle: *{{.Spec.Job}}* run {{.Status.BuildID}} ended *{{.Status.State}}*: {{.Status.URL}} <@U0AKNPBBVT7>"
  steps:
    cluster_profile: aws-quay-qe
    env:
      QUAY_OPERATOR_SOURCE: fbc-operator-catalog
    test:
    - ref: quay-test-e2e
    workflow: ipi-aws
- as: aws-s3-alt
  steps:
    cluster_profile: aws-quay-qe
    test:
    - ref: quay-test-e2e-presubmit
    workflow: ipi-aws
zz_generated_metadata:
  branch: redhat-3.18
  org: quay
  repo: quay
  variant: aws-ocp422-e2e-install
