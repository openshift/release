version: 2

global_defaults:
  image_source: build
  arch: amd64
  repo: quay/quay

managed_files:
  active:
    - quay-quay-redhat-5.0__aws-ocp50-e2e-install.yaml
    - quay-quay-operator-redhat-5.0__aws-ocp50-e2e-chainsaw.yaml
  retired: []

quay:
  - branch: redhat-5.0
    jobs:
      - cron: weekly
        source: nightly
        clouds: [aws]
        ocp: ["5.0"]
        test: e2e-install
      - cron: weekly
        source: nightly
        clouds: [aws]
        ocp: ["5.0"]
        test: e2e-chainsaw
