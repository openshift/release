{% import "tests/_e2e-install.defaults.j2" as d %}
tests:
- steps:
    dependencies:
      QUAY_CI_IMAGE: pipeline:quay-server
    env:
      PLAYWRIGHT_GREP_INVERT: '{{ d.playwright_grep_invert }}|image build context carries the baked classifier artifact path|Nginx 502 error page when backend is unreachable'
      # The lane swaps in quay-server built from the repo's upstream Dockerfile,
      # which does not set RED_HAT_QUAY=true the way Dockerfile.downstream does,
      # so the deployment is not Red Hat branded and the @redhat-branding specs
      # would fail. Keep them disabled here.
      PLAYWRIGHT_BRANDING_E2E: "0"
      PLAYWRIGHT_USE_IMAGE_TESTS: "true"
{%- if storage == "odf" %}
      SETUP_NOOBAA: "true"
      QUAY_STORAGE_PROVIDER: odf
{%- endif %}
    test:
    - ref: merge-stage-registry-credentials
    - ref: quay-enable-catalogsource-art
    - ref: quay-provisioning-tls
    - ref: quay-provisioning-builder
    - ref: quay-deploy-mailpit
    - ref: quay-deploy-jaeger
{%- if storage == "odf" %}
    - ref: quay-install-odf-operator
{%- endif %}
{%- if database_provision_ref %}
    - ref: "{{ database_provision_ref }}"
{%- endif %}
    - ref: "{{ deploy_ref }}"
    - ref: quay-deploy-custom-image
    - ref: quay-test-e2e
