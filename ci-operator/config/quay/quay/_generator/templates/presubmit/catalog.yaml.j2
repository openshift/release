{#
  Presubmits do not render a source layer. Version-bearing Quay branches still
  need the normal ART FBC fallback so quay-enable-catalogsource-art does not
  take its production redhat-operators path. A later catalog-pin layer may
  replace the floating tag with an immutable per-OCP rehearsal catalog.
#}
{% if quay_version is defined %}
tests:
- steps:
    env:
      QUAY_INDEX_IMAGE_REPO: "{{ index_image_repo }}"
      QUAY_INDEX_IMAGE_TAG: "{{ index_image_tag }}"
      QUAY_OPERATOR_SOURCE: fbc-operator-catalog
{% endif %}
