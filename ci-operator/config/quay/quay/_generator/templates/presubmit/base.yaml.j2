base_images:
  cli:
    name: "{{ ocp_version }}"
    namespace: ocp
    tag: cli
build_root:
  image_stream_tag:
    name: release
    namespace: openshift
    tag: rhel-9-release-golang-1.25-openshift-{{ ocp_version }}
{% if test not in ["e2e-legacy", "upgrade-legacy"] %}
images:
  items:
  - dockerfile_path: Dockerfile
    to: quay-server
{% if arch != "amd64" %}
    capabilities: [arm64]
{% endif %}
  - dockerfile_path: web/Containerfile.playwright
    to: quay-playwright-runner
  skip_if_only_changed: ^(\.agents/|\.claude/|ci-generator/|docs/|.*\.md$)
{% endif %}
{% if layout == "base" and arch == "amd64" %}
promotion:
  to:
  - namespace: quay
    tag: latest
    tag_by_commit: true
{% endif %}
releases:
  latest:
{% if test in ['upgrade', 'upgrade-legacy'] %}
    release:
      architecture: amd64
      channel: {{ ocp_channel }}
      version: "{{ ocp_version }}"
{% else %}
    candidate:
      architecture: amd64
      product: ocp
      stream: nightly
      version: "{{ ocp_version }}"
{% endif %}
resources:
  '*':
    limits:
      memory: 4Gi
    requests:
      cpu: 100m
      memory: 200Mi
tests:
- as: "{{ test_as }}"
  timeout: 4h0m0s
{% if test not in ['upgrade', 'upgrade-legacy'] and quay_version is defined %}
  # Versioned presubmits must not inherit the deploy step's stable-3.16 default.
  # Master has no Quay version and keeps that existing default behavior.
  steps:
    env:
      QUAY_OPERATOR_CHANNEL: "{{ operator_channel }}"
{% endif %}
zz_generated_metadata:
  branch: "{{ branch }}"
  org: "{{ org }}"
  repo: "{{ repo }}"
{% if layout != "base" %}
  variant: "{{ variant }}"
{% elif arch != "amd64" %}
  variant: "{{ arch }}"
{% endif %}
