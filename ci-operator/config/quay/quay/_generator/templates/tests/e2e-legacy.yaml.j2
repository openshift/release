tests:
- steps:
    env:
      # quay-test-api-legacy and quay-test-e2e-legacy each create their user
      # with a per-run password; superuser specs that sign in as it need it in
      # SUPER_USERS.
      QUAY_EXTRA_CONFIG: |
        SUPER_USERS:
          - quayapici
          - quaye2eci
      QUAY_VERSION: "{{ quay_version }}"
    test:
    - ref: quay-enable-catalogsource-art
    - ref: "{{ deploy_ref }}"
    - ref: quay-test-e2e-legacy
    - ref: quay-test-api-legacy
