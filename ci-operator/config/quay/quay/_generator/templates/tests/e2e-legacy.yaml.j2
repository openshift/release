tests:
- steps:
    env:
      # quay-test-api-legacy creates this user with a per-run password; the
      # superuser API tests need it in SUPER_USERS.
      QUAY_EXTRA_CONFIG: |
        SUPER_USERS:
          - quayapici
      QUAY_VERSION: "{{ quay_version }}"
    test:
    - ref: quay-enable-catalogsource-art
    - ref: "{{ deploy_ref }}"
    - ref: quay-test-e2e-legacy
    - ref: quay-test-api-legacy
