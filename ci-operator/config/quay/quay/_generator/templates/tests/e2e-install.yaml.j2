{% import "tests/_e2e-install.defaults.j2" as d %}
tests:
- steps:
    env:
      ENABLE_BUILD_SUPPORT: "true"
{%- if fips %}
      FIPS_ENABLED: "true"
      # FEATURE_FIPS requires MAIL_USE_TLS, which Mailpit does not serve, so
      # Mailpit stays off and the @feature:MAILING specs self-skip.
      QUAY_DEPLOY_MAILPIT: "false"
{%- endif %}
{%- if dualstack %}
      IP_FAMILY: DualStackIPv6Primary
      # quay-mirror init gets "connection refused" from quay-app:80 on this
      # IPv6-primary cluster, likely because Quay's TLS nginx config has no
      # [::]:8080 listener. Drop this and the extra grep-invert tests (they
      # need FEATURE_REPO_MIRROR) once a fixed Quay 3.18 build ships.
      QUAY_MIRROR_MANAGED: "false"
      PLAYWRIGHT_GREP_INVERT: '{{ d.playwright_grep_invert }}|auto-pruning does not affect mirror repos|can change repository state|Builds tab not visible for read-only repositories'
{%- else %}
      PLAYWRIGHT_GREP_INVERT: '{{ d.playwright_grep_invert }}'
{%- endif %}
{%- if storage == "odf" %}
      SETUP_NOOBAA: "true"
      QUAY_STORAGE_PROVIDER: odf
{%- endif %}
      QUAY_EXTRA_CONFIG: |
        FEATURE_PROGRAMMATIC_BOOTSTRAP: false
        FEATURE_USER_METADATA: true
        FEATURE_IMMUTABLE_TAGS: true
{%- if quay_version | default("") != "3.16" %}
        FEATURE_SPARSE_INDEX: true
{%- endif %}
        FEATURE_QUOTA_NOTIFICATIONS: true
        FEATURE_EDIT_QUOTA: true
        FEATURE_CHANGE_TAG_EXPIRATION: true
        FEATURE_IMAGE_PULL_STATS: false
        LOG_ARCHIVE_LOCATION: default
        ACTION_LOG_ARCHIVE_LOCATION: default
        SESSION_TIMEOUT: 2h
        DEFAULT_UI: react
        SUPER_USERS:
          - admin
        GLOBAL_READONLY_SUPER_USERS:
          - readonly
{%- if fips %}
        FEATURE_FIPS: true
{%- endif %}
{%- if dualstack %}
        FEATURE_LISTEN_IP_VERSION: dual-stack
{%- endif %}
{%- if quay_version is defined and quay_version.split(".")[0] | int >= 5 %}
        FEATURE_ROBOT_API_TOKENS: true
{%- endif %}
    test:
{%- if fips %}
    - ref: fips-check-fips-or-die
{%- endif %}
    - ref: merge-stage-registry-credentials
    - ref: quay-enable-catalogsource-art
    - ref: quay-provisioning-tls
    - ref: quay-provisioning-builder
    - ref: quay-deploy-mailpit
    - ref: quay-deploy-jaeger
{%- if storage == "odf" %}
    - ref: quay-install-odf-operator
{%- endif %}
    - ref: "{{ deploy_ref }}"
{%- if dualstack %}
    - ref: quay-check-dualstack
{%- endif %}
    - ref: quay-test-e2e
