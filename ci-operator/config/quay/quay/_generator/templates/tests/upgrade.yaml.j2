{# Operator-channel upgrade lane (n-1 -> n). The edge env (PLAYWRIGHT_N_*,
   QUAY_UPGRADE_*_CHANNEL) is derived here from quay_version + upgrade_from; the
   matrix row sets only upgrade_from. The OCP cluster is a stable release (see
   base.yaml.j2), and the OCP e2e releases block is unused. QUAY_EXTRA_CONFIG and
   PLAYWRIGHT_GREP_INVERT are shared with the e2e-install lane via
   _e2e-install.defaults.j2 so a change there reaches both lanes.
   source: stable is the released-operator flavour for branches without the
   Playwright suite: both channels come from the cluster's redhat-operators
   catalog, and release-owned API refs seed and verify instead of Playwright.
   upgrade_target: nightly keeps that n-1 install but upgrades to the ART FBC
   build of n, resolved by quay-enable-catalogsource-art. #}
{% import "tests/_e2e-install.defaults.j2" as d %}
tests:
- timeout: 6h0m0s
  steps:
    allow_best_effort_post_steps: true
    env:
      # Upgrade edge, all derived from quay_version (n) + upgrade_from (n-1):
      #   target channel = stable-<quay_version>, source channel = stable-<upgrade_from>,
      #   n branch = the release branch, n-1 branch = redhat-<upgrade_from>.
      QUAY_UPGRADE_TARGET_CHANNEL: "{{ operator_channel }}"
      QUAY_UPGRADE_SOURCE_CHANNEL: "stable-{{ upgrade_from }}"
{%- if source == "stable" %}
      QUAY_UPGRADE_CATALOG_SOURCE: redhat-operators
{%- if upgrade_target == "nightly" %}
      QUAY_INDEX_IMAGE_REPO: "{{ index_image_repo }}"
      QUAY_INDEX_IMAGE_TAG: "{{ index_image_tag }}"
{%- endif %}
{%- else %}
      PLAYWRIGHT_N_GIT_BRANCH: "{{ branch }}"
      PLAYWRIGHT_N_MINUS_ONE_GIT_BRANCH: "redhat-{{ upgrade_from }}"
      # Static upgrade-lane settings (not version-specific). The per-phase repos
      # default to PLAYWRIGHT_GIT_REPO (base.yaml.j2), so only branches differ.
      PLAYWRIGHT_USE_IMAGE_TESTS: "false"
{%- if source == "nightly" %}
      PLAYWRIGHT_REF_MODE: strict
{%- endif %}
      # Shared by seed, verify, and functional Playwright phases (steps.env).
      PLAYWRIGHT_WORKERS: "4"
      # Reaches only the functional phase: the seed/verify refs do not declare it,
      # and this quarantine excludes their @upgrade-seed/@upgrade-verify specs.
      PLAYWRIGHT_GREP_INVERT: '{{ d.playwright_grep_invert }}'
      # Feature flags the Playwright suite expects; several are unknown to the
      # older releases the stable flavour installs, whose SUPER_USERS default
      # (admin) is enough for the API refs.
      QUAY_EXTRA_CONFIG: |
{{ d.quay_extra_config(quay_version=quay_version | default("")) | indent(8, true) }}
{%- endif %}
      QUAYNAMESPACE: quay
      ENABLE_BUILD_SUPPORT: "true"
    test:
    - ref: merge-stage-registry-credentials
{%- if source != "stable" or upgrade_target == "nightly" %}
    - ref: quay-enable-catalogsource-art
{%- endif %}
    - ref: quay-operator-upgrade-install-source
    - ref: quay-provisioning-tls
    - ref: quay-provisioning-builder
    - ref: quay-deploy-mailpit
    - ref: quay-deploy-jaeger
    - ref: quay-provisioning-storage-s3
    - ref: quay-install-external-storage
    - ref: quay-operator-upgrade-prepare-e2e
{%- if source == "stable" %}
    - ref: quay-create-admin-user
    - ref: quay-operator-upgrade-seed-api
    - ref: quay-operator-upgrade-channel
    - ref: quay-operator-upgrade-verify-api
{%- else %}
    - chain: quay-operator-upgrade-seed
    - ref: quay-operator-upgrade-channel
    - chain: quay-operator-upgrade-verify
    - chain: quay-operator-upgrade-functional
    - ref: quay-operator-upgrade-report
{%- endif %}
