tests:
- steps:
    env:
      MULTISTAGE_PARAM_OVERRIDE_QUAY_INDEX_IMAGE: "{{ fbc_catalog_pullspec }}"
      QUAY_OPERATOR_SOURCE: fbc-operator-catalog
{%- if test == "upgrade" %}
      QUAY_UPGRADE_SOURCE_CATALOG_IMAGE: "{{ fbc_catalog_pullspec }}"
      QUAY_UPGRADE_TARGET_CATALOG_IMAGE: "{{ fbc_catalog_pullspec }}"
{%- endif %}
