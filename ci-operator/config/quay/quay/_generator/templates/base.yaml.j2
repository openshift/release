build_root:
  image_stream_tag:
    name: release
    namespace: openshift
    tag: rhel-9-release-golang-1.25-openshift-{{ build_root_ocp_version }}
{% if test != "e2e-legacy" %}
images:
  items:
  - dockerfile_path: web/Containerfile.playwright
    to: quay-playwright-runner
{% endif %}
prowgen:
  enable_secrets_store_csi_driver: true
releases:
  latest:
    candidate:
      architecture: amd64
      product: ocp
      stream: nightly
      version: "{{ ocp_version }}"
resources:
  '*':
    limits:
      memory: 4Gi
    requests:
      cpu: 100m
      memory: 200Mi
tests:
- as: "{{ test_as }}"
  steps:
    env:
{%- if test != "e2e-legacy" %}
      PLAYWRIGHT_GIT_REPO: https://github.com/quay/quay.git
{%- endif %}
      QUAY_OPERATOR_CHANNEL: "{{ operator_channel }}"
zz_generated_metadata:
  branch: "{{ branch }}"
  org: "{{ org }}"
  repo: "{{ repo }}"
  variant: "{{ variant }}"
