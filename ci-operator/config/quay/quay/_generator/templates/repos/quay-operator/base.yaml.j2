base_images:
  cli:
    name: "{{ ocp_version }}"
    namespace: ocp
    tag: cli
build_root:
  from_repository: true
images:
  items:
  - dockerfile_literal: |
      FROM src
      COPY oc /usr/bin/oc
    from: src
    inputs:
      cli:
        paths:
        - destination_dir: .
          source_path: /usr/bin/oc
    to: src-oc
  # src-oc-sts and quay-sts-tools are the images the quay-sts-* steps run in.
  - dockerfile_literal: |
      FROM pipeline:src-oc
      RUN mkdir -p /tmp/quay-sts-bin && \
          GOFLAGS="" GOBIN=/tmp/quay-sts-bin go install github.com/google/go-containerregistry/cmd/crane@v0.20.3 && \
          GOFLAGS="" GOBIN=/tmp/quay-sts-bin go install github.com/itchyny/gojq/cmd/gojq@v0.12.17 && \
          ln -s /tmp/quay-sts-bin/gojq /tmp/quay-sts-bin/jq
    from: src-oc
    to: src-oc-sts
  - dockerfile_literal: |
      FROM registry.access.redhat.com/ubi9/python-311:1
      RUN pip install --no-cache-dir boto3==1.35.99
    to: quay-sts-tools
releases:
  latest:
    candidate:
      architecture: amd64
      product: ocp
      stream: nightly
      version: "{{ ocp_version }}"
resources:
  '*':
    requests:
      cpu: 100m
      memory: 200Mi
tests:
- as: "{{ test_as }}"
  steps:
    env:
      QUAY_OPERATOR_CHANNEL: "{{ operator_channel }}"
zz_generated_metadata:
  branch: "{{ branch }}"
  org: "{{ org }}"
  repo: "{{ repo }}"
  variant: "{{ variant }}"
