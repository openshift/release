base_images:
  cli:
    name: "{{ ocp_version }}"
    namespace: ocp
    tag: cli
build_root:
  from_repository: true
images:
  items:
  - dockerfile_literal: |
      FROM src
      COPY oc /usr/bin/oc
    from: src
    inputs:
      cli:
        paths:
        - destination_dir: .
          source_path: /usr/bin/oc
    to: src-oc
  # quay-sts-tools is the image quay-sts-provision and quay-sts-cleanup run in.
  - dockerfile_literal: |
      FROM registry.access.redhat.com/ubi9/python-311:1
      RUN pip install --no-cache-dir boto3==1.35.99
    to: quay-sts-tools
releases:
  latest:
    candidate:
      architecture: amd64
      product: ocp
      stream: nightly
      version: "{{ ocp_version }}"
resources:
  '*':
    requests:
      cpu: 100m
      memory: 200Mi
tests:
- as: "{{ test_as }}"
  steps:
    env:
      QUAY_OPERATOR_CHANNEL: "{{ operator_channel }}"
zz_generated_metadata:
  branch: "{{ branch }}"
  org: "{{ org }}"
  repo: "{{ repo }}"
  variant: "{{ variant }}"
