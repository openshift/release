# A complete config, not a layer: build_config renders it alone, because Quay
# standalone HA runs on plain RHEL VMs with no OpenShift cluster to install.
# ocp_version selects only the cli and upi-installer images the steps run in.
base_images:
  upi-installer:
    name: "{{ ocp_version }}"
    namespace: ocp
    tag: upi-installer
build_root:
  image_stream_tag:
    name: release
    namespace: openshift
    tag: rhel-9-release-golang-1.25-openshift-{{ build_root_ocp_version }}
images:
  items:
  - dockerfile_path: web/Containerfile.playwright
    to: quay-playwright-runner
releases:
  latest:
    release:
      architecture: amd64
      channel: stable
      version: "{{ ocp_version }}"
resources:
  '*':
    limits:
      memory: 4Gi
    requests:
      cpu: 100m
      memory: 200Mi
tests:
- as: "{{ test_as }}"
  steps:
    cluster_profile: aws-quay-qe
    workflow: quay-standalone-aws-ha
  timeout: 8h0m0s
zz_generated_metadata:
  branch: "{{ branch }}"
  org: "{{ org }}"
  repo: "{{ repo }}"
  variant: "{{ variant }}"
