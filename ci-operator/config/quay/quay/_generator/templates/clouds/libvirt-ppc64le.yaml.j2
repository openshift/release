base_images:
  dev-scripts:
    name: test
    namespace: ocp-kni
    tag: dev-scripts
tests:
# build12 is where the multiarch ppc64le s2s jobs run; on build09 the Quay
# *.apps route did not resolve from the test pod (PR #86088 rehearsals).
- cluster: build12
  steps:
    cluster_profile: libvirt-ppc64le-s2s
    dependencies:
      OPENSHIFT_INSTALL_TARGET: release:ppc64le-latest
    env:
      QUAY_DEPLOY_MAILPIT: "false"
    workflow: quay-tests-libvirt-ppc64le
