tests:
- steps:
    cluster_profile: openshift-org-gcp
    env:
      COMPUTE_NODE_TYPE: n1-standard-16
      QUAY_STORAGE_PROVIDER: gcp
    post:
    - ref: quay-gather-jaeger-traces
    - ref: quay-gather
    - ref: quay-deprovision
{%- if database_deprovision_ref %}
    - ref: "{{ database_deprovision_ref }}"
{%- endif %}
    - chain: ipi-gcp-post
    workflow: ipi-gcp
