  retired: []
  # Hand-written configs in this directory, with the `as` of each test they
  # hold. --check fails on any other config here, or on a test added to these.
  hand_maintained:
    quay-quay-master__claim.yaml: [claim-cluster]
    quay-quay-master__deploy-tools.yaml: []
    quay-quay-master__omr-v2-upgrade-v3.yaml: [disconnected-install]
    quay-quay-master__omr-v3.yaml: [disconnected-install]
    quay-quay-mirror-registry-3.0__omr-v3.yaml: [disconnected-install]

quay:
  - branch: redhat-3.18
    jobs:
      # Keep the pre-existing 4.22 daily lane and the 4.14 weekly lane. The
      # rest of the canonical FBC grid is optional and rehearsal-only below.
      - cron: daily
        source: nightly
        clouds: [aws]
        ocp: ["4.22"]
        test: e2e-install
      - cron: weekly
        source: nightly
        clouds: [aws]
        ocp: ["4.14"]
        test: e2e-install
      - kind: presubmit
        clouds: [aws]
        ocp: ["4.12", "4.13", "4.15", "4.16", "4.17", "4.18", "4.19", "4.20", "4.21"]
        test: e2e-install
        always_run: false
        optional: true
      - cron: daily
        source: nightly
        clouds: [gcp,azure]
        ocp: ["4.22"]
        test: e2e-install
      # Sibling of the daily row: same files, distinct as (e.g. aws-s3-rds-nightly).
      # Uses quay-database-intg-{aws-rds,azure-postgres} before deploy.
      - cron: weekly
        source: nightly
        clouds: [aws,azure]
        ocp: ["4.22"]
        test: e2e-install
        database: true
      - cron: weekly
        source: nightly
        clouds: [aws]
        ocp: ["5.0"]
        test: e2e-install
      - cron: weekly
        source: nightly
        clouds: [aws]
        ocp: ["4.22"]
        test: e2e-install
        arches: [arm64]
      - cron: weekly
        source: nightly
        clouds: [aws]
        ocp: ["4.22"]
        test: e2e-install
        fips: true
      - cron: 0 8 * * 2
        source: nightly
        clouds: [libvirt]
        ocp: ["4.22"]
        test: e2e-install
        arches: [s390x]
      - cron: daily
        source: nightly
        clouds: [aws]
        ocp: ["4.22"]
        test: e2e-install
        storage: odf
      # Operator-channel upgrade lane: install n-1 (stable-3.17), seed it, OLM-upgrade
      # to n (stable-3.18), then verify/functional Playwright phases. Runs on a
      # stable OCP cluster (see templates/base.yaml.j2). source: nightly selects
      # the ART FBC env layer that resolves the operator catalog digest.
      # Only the n-1 version is specified; the target channel/branch (from
      # quay_version), the source channel/branch (from upgrade_from), the job name
      # (from-317), and the static env all come from the generator + upgrade
      # template.
      - cron: nightly
        source: nightly
        clouds: [aws]
        ocp: ["4.22"]
        test: upgrade
        upgrade_from: "3.17"
      - kind: presubmit
        clouds: [aws]
        ocp: ["4.12", "4.13", "4.14", "4.15", "4.16", "4.17", "4.18", "4.19", "4.20", "4.21"]
        test: upgrade
        upgrade_from: "3.17"
        always_run: false
        optional: true
  - branch: redhat-3.17
    jobs:
      - cron: daily
        source: nightly
        clouds: [aws]
        ocp: ["4.22"]
        test: e2e-install
      - kind: presubmit
        clouds: [aws]
        ocp: ["4.12", "4.13", "4.14", "4.15", "4.16", "4.17", "4.18", "4.19", "4.20", "4.21"]
        test: e2e-install
        always_run: false
        optional: true
      - cron: daily
        source: nightly
        clouds: [gcp,azure]
        ocp: ["4.22"]
        test: e2e-install
      # Sibling of the daily row, matching the 3.18 database lane; Quay 3.17
      # supports PostgreSQL 17, so the steps' default version applies.
      - cron: weekly
        source: nightly
        clouds: [aws,azure]
        ocp: ["4.22"]
        test: e2e-install
        database: true
      - cron: daily
        source: nightly
        clouds: [aws]
        ocp: ["4.22"]
        test: e2e-install
        storage: odf
      - cron: weekly
        source: nightly
        clouds: [aws]
        ocp: ["4.22"]
        test: e2e-install
        fips: true
      - cron: nightly
        source: nightly
        clouds: [aws]
        ocp: ["4.22"]
        test: upgrade
        upgrade_from: "3.16"
      - kind: presubmit
        clouds: [aws]
        ocp: ["4.12", "4.13", "4.14", "4.15", "4.16", "4.17", "4.18", "4.19", "4.20", "4.21"]
        test: upgrade
        upgrade_from: "3.16"
        always_run: false
        optional: true
  - branch: redhat-5.0
    jobs:
      - cron: daily
        source: nightly
        clouds: [aws,gcp,azure]
        ocp: ["5.0"]
        test: e2e-install
      # True bare metal on AWS: *.metal workers are full physical hosts with no
      # hypervisor.
      # Same S3-backed deploy as the aws lane, except the worker machine type
      # (ipi-conf-aws consumes COMPUTE_NODE_TYPE) and the builder: the QEMU
      # ("bare metal") executor boots each build in a qemu-kvm VM, which needs
      # /dev/kvm on the workers; the other lanes run kubernetesPodman. Masters
      # stay on regular VMs to keep the cost down. Weekly because metal
      # instances run ~5-10x the hourly price of the equivalent VM sizes.
      - cron: weekly
        source: nightly
        clouds: [aws-metal]
        ocp: ["5.0"]
        test: e2e-install
        env:
          QUAY_BUILDER_EXECUTOR: kubernetes
      - cron: weekly
        source: nightly
        clouds: [aws,azure]
        ocp: ["5.0"]
        test: e2e-install
        database: true
      - cron: weekly
        source: nightly
        clouds: [aws]
        ocp: ["5.0"]
        test: e2e-install
        fips: true
      - cron: weekly
        source: nightly
        clouds: [aws]
        ocp: ["5.0"]
        test: e2e-install
        arches: [arm64]
      - cron: daily
        source: nightly
        clouds: [aws]
        ocp: ["5.0"]
        test: e2e-install
        storage: odf
      - cron: weekly
        source: nightly
        clouds: [aws]
        ocp: ["5.0"]
        test: e2e-chainsaw
      # Quay 5.0's ART FBC exists only for OCP v5.0, and OCP 5.0 has no stable
      # channel yet: install from candidate until it goes GA.
      - cron: nightly
        source: nightly
        clouds: [aws]
        ocp: ["5.0"]
        test: upgrade
        upgrade_from: "3.18"
        ocp_channel: candidate
  # Keep the pre-existing 4.21 scheduled lanes. The remaining canonical cells
  # are optional presubmits; their exact catalog selection comes from the
  # private rehearsal overlay, not a public floating ART tag.
  - branch: redhat-3.16
    jobs:
      - cron: daily
        source: nightly
        clouds: [aws]
        ocp: ["4.21"]
        test: e2e-install
      - kind: presubmit
        clouds: [aws]
        ocp: ["4.12", "4.13", "4.14", "4.15", "4.16", "4.17", "4.18", "4.19", "4.20", "4.22"]
        test: e2e-install
        always_run: false
        optional: true
      - cron: daily
        source: nightly
        clouds: [gcp,azure]
        ocp: ["4.21"]
        test: e2e-install
      - cron: daily
        source: nightly
        clouds: [aws]
        ocp: ["4.21"]
        test: e2e-install
        storage: odf
  # Quay 3.9-3.15 use the Cypress old-UI and REST API suites. These are the
  # canonical AWS/S3 FBC lanes; no optional storage/platform variants are
  # multiplied across historical streams.
  - branch: redhat-3.15
    jobs:
      - cron: daily
        source: stable
        clouds: [aws]
        ocp: ["4.19"]
        test: e2e-legacy
        as: aws-s3
      - kind: presubmit
        clouds: [aws]
        ocp: ["4.12", "4.13", "4.14", "4.15", "4.16", "4.17", "4.18", "4.20", "4.21", "4.22"]
        test: e2e-legacy
        as: aws-s3
        always_run: false
        optional: true
  - branch: redhat-3.14
    jobs:
      - cron: daily
        source: stable
        clouds: [aws]
        ocp: ["4.19"]
        test: e2e-legacy
        as: aws-s3
      - kind: presubmit
        clouds: [aws]
        ocp: ["4.12", "4.13", "4.14", "4.15", "4.16", "4.17", "4.18", "4.20", "4.21", "4.22"]
        test: e2e-legacy
        as: aws-s3
        always_run: false
        optional: true
  # 3.13 remains available through the unified catalog channel.
  - branch: redhat-3.13
