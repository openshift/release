  - branch: redhat-3.10
    jobs:
      - cron: daily
        source: stable
        clouds: [aws]
        ocp: ["4.15"]
        test: e2e-legacy
        as: aws-s3
      - kind: presubmit
        clouds: [aws]
        ocp: ["4.12", "4.13", "4.14", "4.16", "4.17", "4.18", "4.19", "4.20", "4.21", "4.22"]
        test: e2e-legacy
        as: aws-s3
        always_run: false
        optional: true
  - branch: redhat-3.9
    jobs:
      - cron: daily
        source: stable
        clouds: [aws]
        ocp: ["4.14"]
        test: e2e-legacy
        as: aws-s3
      - kind: presubmit
        clouds: [aws]
        ocp: ["4.12", "4.13", "4.15", "4.16", "4.17", "4.18", "4.19", "4.20", "4.21", "4.22"]
        test: e2e-legacy
        as: aws-s3
        always_run: false
        optional: true
  - branch: master
    layout: base
    env:
      QUAY_OPERATOR_CHANNEL: stable-3.18
      # Presubmit jobs render no source layer, so the ART FBC env that periodics
      # get from templates/sources/nightly.yaml.j2 must be set here instead.
      # master has no quay_version to derive the FBC tag from, so pin it to the
      # onboarded quay-3.18 FBC group (OCP v4.22 matches the job's ocp below).
      QUAY_INDEX_IMAGE_REPO: quay.io/redhat-user-workloads/ocp-art-tenant/art-fbc
      QUAY_INDEX_IMAGE_TAG: quay-3.18__v4.22__quay-rhel9-operator
      QUAY_OPERATOR_SOURCE: fbc-operator-catalog
    jobs:
      - kind: presubmit
        clouds: [aws, gcp, azure]
        ocp: ["4.22"]
        test: e2e-install
        always_run: false
        optional: true
      - kind: presubmit
        clouds: [aws]
        ocp: ["4.22"]
        test: e2e-install
        storage: odf
        always_run: false
        optional: true
