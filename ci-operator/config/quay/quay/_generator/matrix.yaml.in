version: 2

global_defaults:
  image_source: build
  arch: amd64
  repo: quay/quay

managed_files:
  active:
    - quay-quay-master.yaml
    - quay-quay-redhat-3.18__aws-ocp422-e2e-install.yaml
    - quay-quay-redhat-3.18__aws-ocp50-e2e-install.yaml
    - quay-quay-redhat-3.18__gcp-ocp422-e2e-install.yaml
    - quay-quay-redhat-3.18__aws-arm64-ocp422-e2e-install.yaml
    - quay-quay-redhat-3.18__libvirt-s390x-ocp422-e2e-install.yaml
  retired: []

quay:
  - branch: redhat-3.18
    jobs:
      - cron: daily
        source: nightly
        clouds: [aws,gcp]
        ocp: ["4.22"]
        test: e2e-install
      - cron: weekly
        source: nightly
        clouds: [aws]
        ocp: ["5.0"]
        test: e2e-install
      - cron: weekly
        source: nightly
        clouds: [aws]
        ocp: ["4.22"]
        test: e2e-install
        arches: [arm64]
      - cron: 0 8 * * 2
        source: nightly
        clouds: [libvirt]
        ocp: ["4.22"]
        test: e2e-install
        arches: [s390x]
        # No s390x Mailpit image (QUAY_DEPLOY_MAILPIT=false), so skip the
        # Mailpit-dependent specs on top of the default filter. Must track
        # templates/tests/_e2e-install.defaults.j2's playwright_grep_invert.
        env:
          PLAYWRIGHT_GREP_INVERT: "@auth:OIDC|@auth:LDAP|@feature:QUOTA_NOTIFICATIONS|@webhook|saves and loads architecture filter with mirror configuration|loads existing architecture filter from saved mirror configuration|Email Lookup|export delivery"
  - branch: master
    layout: base
    env:
      QUAY_OPERATOR_CHANNEL: stable-3.18
      QUAY_OPERATOR_SOURCE: redhat-operators
    jobs:
      - kind: presubmit
        clouds: [aws, gcp]
        ocp: ["4.22"]
        test: e2e-install
        always_run: false
        optional: true
