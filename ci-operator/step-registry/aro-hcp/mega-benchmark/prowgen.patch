+seed_start="$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)"
+printf 'MEGA_BENCHMARK_NATIVE_START phase=seed utc=%s\n' "${seed_start}"
+printf '{"phase":"seed","event":"start","utc":"%s"}\n' "${seed_start}" >> "${artifact_root}/shared-native-events.jsonl"
+set +o errexit
+ARTIFACTS="${artifact_root}/seed" ci-operator "${seed_args[@]}"
+seed_status=$?
+seed_end="$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)"
+set -o errexit
+printf 'MEGA_BENCHMARK_NATIVE_END phase=seed utc=%s exit=%s\n' "${seed_end}" "${seed_status}"
+printf '{"phase":"seed","event":"end","utc":"%s","exit":%s}\n' "${seed_end}" "${seed_status}" >> "${artifact_root}/shared-native-events.jsonl"
+printf '%s\n' "${seed_status}" > "${artifact_root}/seed/native-exit-status.txt"
+if [ "${seed_status}" -ne 0 ]; then
+    printf '{"phase":"warm","event":"skipped","reason":"integration-failed"}\n' >> "${artifact_root}/shared-native-events.jsonl"
+    exit "${seed_status}"
+fi
+printf '%s' "${JOB_SPEC}" | sha256sum > "${artifact_root}/warm/job-spec.sha256"
+printf '%q ' ci-operator "${warm_args[@]}" > "${artifact_root}/warm/operator-argv.txt"
+warm_start="$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)"
+printf 'MEGA_BENCHMARK_NATIVE_START phase=warm utc=%s\n' "${warm_start}"
+printf '{"phase":"warm","event":"start","utc":"%s"}\n' "${warm_start}" >> "${artifact_root}/shared-native-events.jsonl"
+set +o errexit
+ARTIFACTS="${artifact_root}/warm" ci-operator "${warm_args[@]}"
