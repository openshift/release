+warm_end="$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)"
+set -o errexit
+printf 'MEGA_BENCHMARK_NATIVE_END phase=warm utc=%s exit=%s\n' "${warm_end}" "${warm_status}"
+printf '{"phase":"warm","event":"end","utc":"%s","exit":%s}\n' "${warm_end}" "${warm_status}" >> "${artifact_root}/shared-native-events.jsonl"
+printf '%s\n' "${warm_status}" > "${artifact_root}/warm/native-exit-status.txt"
+exit "${warm_status}"
+`
