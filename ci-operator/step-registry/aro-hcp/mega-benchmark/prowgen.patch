+// Configure the controlled benchmark's sequential native invocations and inline its fully resolved configuration.
+func configureControlledMegaSharedPeriodic(periodic *prowconfig.Periodic, configSpec *cioperatorapi.ReleaseBuildConfiguration) error {
+	resolved, err := yaml.Marshal(configSpec)
+	if err != nil {
+		return fmt.Errorf("serialize controlled benchmark configuration: %w", err)
+	}
+	container := &periodic.Spec.Containers[0]
+	container.Env = append(container.Env, corev1.EnvVar{Name: "CONFIG_SPEC", Value: string(resolved)})
+	container.Command = []string{"/bin/bash", "-c", controlledMegaSharedCommands, "mega-shared-native-operator"}
+	return nil
+}
