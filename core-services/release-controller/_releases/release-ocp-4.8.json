      "maxRetries": 3,
      "prowJob":{"name":"periodic-ci-openshift-release-main-nightly-4.8-e2e-aws-serial"}
    },
    "azure":{
      "optional":true,
      "prowJob":{"name":"periodic-ci-openshift-release-main-nightly-4.8-e2e-azure"},
