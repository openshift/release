{
  "name":"4.8.0-0.nightly",
  "endOfLife": true,
  "to": "release",
  "message": "This release contains official image builds of all code in release-4.8 (main) branches, and is updated after those builds are synced to quay.io.",
  "mirrorPrefix": "4.8-art-latest",
  "expires":"126h",
  "maxUnreadyReleases": 1,
  "minCreationIntervalSeconds": 21600,
  "referenceMode": "source",
  "pullSecretName": "source",
  "overrideCLIImage": "image-registry.openshift-image-registry.svc:5000/ocp/4.11-art-latest:cli",
  "check":{
    "OCP and Origin images should match": {
      "consistentImages":{"parent":"4.8.0-0.ci"}
    }
  },
  "publish":{
    "tag":{"tagRef":{"name":"4.8"}},
    "issues": {
      "verifyIssues": {
        "previousReleaseTag": {
          "namespace": "ocp",
          "name": "release",
          "tag": "4.8.0-rc.0"
        }
      }
    }
  },
  "verify":{
    "aws":{
      "maxRetries": 3,
      "prowJob":{"name":"periodic-ci-openshift-release-main-nightly-4.8-e2e-aws"}
    },
