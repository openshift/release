{
  "name": "4.23.0-0.nightly-multi",
  "message": "This release contains official image builds of all multi-arch code in release-4.23 (main) branches, and is updated after those builds are synced to quay.io.",
  "mirrorPrefix": "4.23-art-latest-multi",
  "expires": "336h",
  "maxUnreadyReleases": 1,
  "minCreationIntervalSeconds": 21600,
  "referenceMode": "source",
  "pullSecretName": "source",
  "alternateImageRepository": "quay.io/openshift-release-dev/dev-release",
  "alternateImageRepositorySecretName": "release-controller-quay-mirror-secret",
  "as": "Stable",
  "overrideCLIImage": "image-registry.openshift-image-registry.svc:5000/ocp/4.23-art-latest:cli",
  "check": {},
  "publish": {},
  "verify": {
    "e2e-aws-ovn-multi-x-x": {
      "optional": true,
      "maxRetries": 2,
      "prowJob": {
        "name": "periodic-ci-openshift-multiarch-main-nightly-4.23-ocp-e2e-aws-ovn-multi-x-x"
      }
    },
    "e2e-aws-ovn-multi-a-a": {
      "optional": true,
      "maxRetries": 2,
      "prowJob": {
        "name": "periodic-ci-openshift-multiarch-main-nightly-4.23-ocp-e2e-aws-ovn-multi-a-a"
      }
    },
    "e2e-nightly-upgrade-aws-ovn-multi-a-a": {
      "optional": true,
      "prowJob": {
        "name": "periodic-ci-openshift-multiarch-main-nightly-4.23-ocp-e2e-upgrade-aws-ovn-multi-a-a"
      },
      "upgrade": true,
      "upgradeFrom": "Previous"
    },
    "e2e-aws-ovn-minor-upgrade-multi-a-a": {
      "optional": true,
      "prowJob": {
        "name": "periodic-ci-openshift-multiarch-main-nightly-4.23-upgrade-from-stable-4.22-ocp-e2e-upgrade-aws-ovn-multi-a-a"
      },
      "upgrade": true,
      "upgradeFromRelease": {
        "candidate": {
          "stream": "nightly-multi",
          "version": "4.22"
        }
      }
    },
    "hypershift-e2e-aks-multi-x-ax": {
      "optional": true,
      "maxRetries": 2,
      "prowJob": {
        "name": "periodic-ci-openshift-hypershift-release-4.23-periodics-e2e-aks-multi-x-ax"
      },
      "upgrade": true,
      "upgradeFrom": "Previous"
    }
  }
}
