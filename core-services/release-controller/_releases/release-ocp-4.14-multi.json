{
  "name": "4.14.0-0.nightly-multi",
  "message": "This release contains official image builds of all multi-arch code in release-4.14 (main) branches, and is updated after those builds are synced to quay.io.",
  "mirrorPrefix": "4.14-art-latest-multi",
  "expires": "168h",
  "maxUnreadyReleases": 1,
  "minCreationIntervalSeconds": 86400,
  "referenceMode": "source",
  "pullSecretName": "source",
  "alternateImageRepository": "quay.io/openshift-release-dev/dev-release",
  "alternateImageRepositorySecretName": "release-controller-quay-mirror-secret",
  "as": "Stable",
  "overrideCLIImage": "image-registry.openshift-image-registry.svc:5000/ocp/4.14-art-latest:cli",
  "check": {},
  "publish": {},
  "verify": {
    "multi-e2e-ovn": {
      "maxRetries": 1,
      "prowJob": {
        "name": "periodic-ci-openshift-multiarch-main-nightly-4.14-ocp-e2e-aws-ovn-heterogeneous"
      }
    },
    "e2e-nightly-upgrade-aws-ovn-multi-a-a": {
      "optional": true,
      "prowJob": {
        "name": "periodic-ci-openshift-multiarch-main-nightly-4.14-ocp-e2e-upgrade-aws-ovn-multi-a-a"
      },
      "upgrade": true,
      "upgradeFrom": "Previous"
    },
    "e2e-aws-ovn-minor-upgrade-multi-a-a": {
      "optional": true,
      "prowJob": {
        "name": "periodic-ci-openshift-multiarch-main-nightly-4.14-upgrade-from-stable-4.13-ocp-e2e-upgrade-aws-ovn-multi-a-a"
      },
      "upgrade": true,
      "upgradeFromRelease": {
        "candidate": {
          "stream": "nightly-multi",
          "version": "4.13"
        }
      }
    }
  }
}
