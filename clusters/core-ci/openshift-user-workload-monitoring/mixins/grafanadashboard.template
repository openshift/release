{
  "apiVersion": "grafana.integreatly.org/v1beta1",
  "kind": "GrafanaDashboard",
  "metadata": {
    "name": "{{DASHBOARD_NAME}}",
    "namespace": "ci-grafana",
    "labels": {
      "app": "grafana",
      "ci.openshift.io/gitops-managed": "true"
    }
  },
  "spec": {
    "instanceSelector": {
      "matchLabels": {
        "dashboards": "grafana"
      }
    },
    "json": (importstr "{{IMPORT_STRING_PATH}}.json"),
  }
}
